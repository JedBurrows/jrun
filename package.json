{
  "name": "@jed-dev/jrun",
  "version": "0.4.0",
  "description": "CLI for running Java projects with process management",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "jrun": "./bin/jrun"
  },
  "files": ["bin", "dist"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jedburrows/jrun.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/main.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "changelog": "git-cliff --output CHANGELOG.md",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@clack/prompts": "^1.1.0",
    "@effect/cli": "^0.73.2",
    "@effect/platform": "^0.94.5",
    "@effect/platform-node": "^0.104.1",
    "effect": "^3.20.0",
    "ink": "^6.8.0",
    "react": "^19.2.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@effect/vitest": "latest",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "ink-testing-library": "^4.0.0",
    "tsup": "latest",
    "tsx": "latest",
    "typescript": "^5.7.0",
    "vitest": "^2.0.0"
  }
}
